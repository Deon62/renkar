{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/service-worker.js",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "dest": "/service-worker.js"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/(.*\\.(?:css|js|json|png|jpg|jpeg|gif|ico|svg))",
      "dest": "/$1"
    },
    {
      "src": "^/(about|booking|profile|driver|owner-dashboard|owner-finances|owner-profile|owner-verification|register-car-owner|join-owner|verification|support|driver-profile|driver-finances|owner-bookings|car-details|checkout|payment-success|booking-history|offline)(?:/|$)",
      "dest": "/$1.html"
    },
    {
      "src": "^/(.*)",
      "dest": "/index.html"
    }
  ],
  "trailingSlash": false
}
