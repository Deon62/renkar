{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/service-worker.js$",
      "dest": "/service-worker.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "^/(.*)",
      "dest": "/index.html"
    }
  ]
}
